<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="catalogsearch.navigation.renderer">
            <arguments>
                <argument name="venbhas_filter_config" xsi:type="object">
                    Venbhas\FilterMultiselect\ViewModel\FilterConfig
                </argument>
            </arguments>
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Venbhas_FilterMultiselectHyva::layer/filter.phtml</argument>
            </action>
        </referenceBlock>
    </body>
</page>
