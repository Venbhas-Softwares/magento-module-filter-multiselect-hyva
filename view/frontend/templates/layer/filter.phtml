<?php
/**
 * Hyvä layered navigation filter template with optional multi-select checkboxes.
 *
 * @var \Magento\LayeredNavigation\Block\Navigation\FilterRenderer $block
 * @var \Magento\Catalog\Model\Layer\Filter\Item[] $filterItems
 * @var \Magento\Framework\Escaper $escaper
 * @var \Venbhas\FilterMultiselect\ViewModel\FilterConfig $filterConfig
 */

/** @var \Venbhas\FilterMultiselect\ViewModel\FilterConfig $filterConfig */
$filterConfig = $block->getData('venbhas_filter_config');
$showProductCount = $filterConfig ? $filterConfig->shouldDisplayProductCount() : false;

$filter = $block->getFilter() ?? (!empty($filterItems) ? $filterItems[0]->getFilter() : null);
$isPriceFilter = $filter && ($filter->getRequestVar() === 'price');

$useCheckboxes = !$isPriceFilter
    && $filterConfig
    && $filterConfig->isMultiselectForFilter($filter);

$hasActiveSelection = false;
foreach ($filterItems as $filterItem) {
    /** @var \Venbhas\FilterMultiselect\Model\Layer\Filter\Item $filterItem */
    if ($useCheckboxes) {
        if ($filterItem->isSelected()) {
            $hasActiveSelection = true;
            break;
        }
    } elseif ((int) $filterItem->getCount() > 0 && $filterItem->isSingleSelectSelected()) {
        $hasActiveSelection = true;
        break;
    }
}
?>
<ol role="list"
    class="items venbhas-filter-multiselect"
    data-venbhas-request-var="<?= $escaper->escapeHtmlAttr($filter ? $filter->getRequestVar() : '') ?>"
    data-venbhas-has-active="<?= $hasActiveSelection ? '1' : '0' ?>"
    aria-label="<?= $escaper->escapeHtmlAttr(__('%1 filter options', $block->getFilterTitle())) ?>">
    <?php foreach ($filterItems as $filterItem): ?>
        <?php
        /** @var \Venbhas\FilterMultiselect\Model\Layer\Filter\Item $filterItem */
        if ($useCheckboxes) {
            $isSelected = $filterItem->isSelected();
            $filterUrl = $isSelected ? $filterItem->getRemoveUrl() : $filterItem->getUrl();
        } else {
            $isSelected = $filterItem->isSingleSelectSelected();
            $filterUrl = $isSelected
                ? $filterItem->getSingleSelectRemoveUrl()
                : $filterItem->getSingleSelectUrl();
        }
        $filterItemDomId = 'filter-item-' . (string) $filterItem->getValue();
        $filterLabelPlain = strip_tags((string) $filterItem->getLabel());
        if ((int) $filterItem->getCount() === 1) {
            $filterAriaLabel = (string) __('%1 filter, 1 available product', $filterLabelPlain);
        } else {
            $filterAriaLabel = (string) __(
                '%1 filter, %2 available products',
                $filterLabelPlain,
                $filterItem->getCount()
            );
        }
        ?>
        <li class="item<?= $isSelected ? ' active' : '' ?>">
            <?php if ($useCheckboxes): ?>
                <label
                    for="<?= $escaper->escapeHtmlAttr($filterItemDomId) ?>"
                    class="flex justify-between py-1 cursor-pointer hover:text-black"
                >
                    <span class="flex items-center gap-2">
                        <input type="checkbox"
                               class="filter-checkbox"
                               id="<?= $escaper->escapeHtmlAttr($filterItemDomId) ?>"
                               <?= $isSelected ? 'checked="checked"' : '' ?>
                               data-url="<?= $escaper->escapeHtmlAttr($filterUrl) ?>"
                        />
                        <span><?= /* @noEscape */ $filterItem->getLabel() ?></span>
                    </span>
                    <?php if ($showProductCount): ?>
                        <span class="count"><?= (int) $filterItem->getCount() ?></span>
                    <?php endif; ?>
                </label>
            <?php else: ?>
                <?php if ($filterItem->getCount() > 0): ?>
                    <a href="<?= $escaper->escapeUrl($filterUrl) ?>"
                       class="flex justify-between py-1 hover:text-black<?= $isSelected ? ' font-semibold' : '' ?>"
                       aria-label="<?= $escaper->escapeHtmlAttr($filterAriaLabel) ?>"
                    >
                        <span><?= /* @noEscape */ $filterItem->getLabel() ?></span>
                        <?php if ($showProductCount): ?>
                            <span class="count"><?= (int) $filterItem->getCount() ?></span>
                        <?php endif; ?>
                    </a>
                <?php else: ?>
                    <span class="flex justify-between py-1 hover:text-black">
                        <span><?= /* @noEscape */ $filterItem->getLabel() ?></span>
                        <?php if ($showProductCount): ?>
                            <span class="count"><?= (int) $filterItem->getCount() ?></span>
                        <?php endif; ?>
                    </span>
                <?php endif; ?>
            <?php endif; ?>
        </li>
    <?php endforeach; ?>
</ol>
